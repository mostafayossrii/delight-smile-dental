# ==============================================================================
# DELIGHT SMILE DENTAL CLINIC MANAGEMENT PLATFORM - ENVIRONMENT VARIABLES
# ==============================================================================

# Public Supabase Configuration (Safe for client/browser exposure)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
NEXT_PUBLIC_APP_URL=https://delight-smile-dental.vercel.app
NEXT_PUBLIC_DEFAULT_CURRENCY=EGP
NEXT_PUBLIC_DEFAULT_LOCALE=ar
NEXT_PUBLIC_CLINICAL_STORAGE_BUCKET=clinical-private

# Server-Only Secrets (NEVER expose to browser or mobile client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SESSION_SIGNING_SECRET=your-32-byte-hex-session-secret
ADMIN_BOOTSTRAP_TOKEN=your-production-bootstrap-secret

# Firebase Cloud Messaging (FCM) Push Notifications
FCM_PROJECT_ID=your-firebase-project-id
FCM_CLIENT_EMAIL=your-fcm-service-account@project.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASC...==\n-----END PRIVATE KEY-----\n"

# Optional External Communication Providers (Zero-cost fallbacks are active if empty)
EMAIL_PROVIDER_API_KEY=
SMS_PROVIDER_API_KEY=
WHATSAPP_PROVIDER_TOKEN=

# Development Seed Flag (MUST BE FALSE IN PRODUCTION)
ALLOW_DEV_SEED=false
