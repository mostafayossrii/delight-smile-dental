# Public Supabase configuration (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CURRENCY=EGP
NEXT_PUBLIC_DEFAULT_LOCALE=ar

# Server-only secrets (NEVER expose in client code or prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here
SESSION_SIGNING_SECRET=replace-with-32-byte-hex-secret
ADMIN_BOOTSTRAP_TOKEN=replace-with-production-bootstrap-secret

# Optional Official Notification Providers (Leave empty until configured)
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Development Seed Flag (MUST be false in production)
ALLOW_DEV_SEED=true
